index=soc_lab sourcetype=soc_lab_json type="ssh_failure"
| eval minute_bucket=relative_time(_time,"@min")
| stats count AS failed_attempts min(_time) AS first_seen max(_time) AS last_seen BY minute_bucket src_ip dst_ip
| where failed_attempts >= 5
| convert ctime(first_seen) ctime(last_seen)
| table src_ip dst_ip failed_attempts first_seen last_seen
